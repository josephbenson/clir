{
  "name": "@josephbenson/clir",
  "version": "0.1.0",
  "description": "Run any GitHub repo or local project locally with one command",
  "type": "module",
  "bin": {
    "clir": "./dist/index.js"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    ".env.example"
  ],
  "scripts": {
    "build": "tsc",
    "postbuild": "chmod +x dist/index.js",
    "dev": "tsc --watch",
    "start": "node dist/index.js"
  },
  "keywords": [
    "cli",
    "developer-tools",
    "github",
    "runner",
    "setup"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/josephbenson/clir.git"
  },
  "homepage": "https://github.com/josephbenson/clir#readme",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "commander": "^12.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
